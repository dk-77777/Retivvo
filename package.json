{
  "name": "retivvo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "db:prepare": "node scripts/prepare.mjs",
    "start:host": "node server/start.ts",
    "start": "node --env-file=.env.api server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/security.test.ts",
    "lint": "eslint server scripts web tests/*.ts vite.config.ts playwright.config.ts",
    "format:check": "prettier --check server scripts web tests/*.ts eslint.config.js vite.config.ts playwright.config.ts index.html",
    "secrets:check": "bash scripts/check-secrets.sh",
    "build": "vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "better-auth": "1.7.26",
    "fastify": "5.12.8",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
